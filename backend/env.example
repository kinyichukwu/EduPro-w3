# Server Configuration
PORT=8080
GIN_MODE=release
ENVIRONMENT=development
LOG_LEVEL=info
RATE_LIMIT=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/edupro

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# Storage Configuration
BUCKET_NAME=documents

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# For development, use devnet: https://api.devnet.solana.com
# For testing, use testnet: https://api.testnet.solana.com

# EduPro Token Configuration
EDUPRO_MINT_ADDRESS=your-edutoken-mint-address
EDUPRO_MINT_AUTHORITY_SECRET_BASE58=your-mint-authority-private-key-base58

# Platform Fee Configuration (in basis points, 250 = 2.5%)
EDUPRO_PLATFORM_FEE_BPS=250

# Jupiter Swap Configuration
EDUPRO_JUPITER_API_BASE=https://quote-api.jup.ag/v6

# Staking Configuration (optional - for future staking features)
EDUPRO_STAKING_PROGRAM_ID=your-staking-program-id
EDUPRO_STAKING_TREASURY=your-staking-treasury-address

# Example values for development/testing:
# SOLANA_RPC_URL=https://api.devnet.solana.com
# EDUPRO_MINT_ADDRESS=So11111111111111111111111111111111111111112
# EDUPRO_MINT_AUTHORITY_SECRET_BASE58=your-base58-encoded-private-key
# EDUPRO_PLATFORM_FEE_BPS=250
# EDUPRO_JUPITER_API_BASE=https://quote-api.jup.ag/v6
